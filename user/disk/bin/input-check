#!/bin/sh
# what the input devices look like to the libraries that find them: the files, what libudev reads, what libinput says
export SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 SYSTEMD_LOG_LEVEL=debug PAGER=cat

echo "== /dev/input"; ls -l /dev/input
echo "== /sys/class/input"; ls -l /sys/class/input
echo "== /run/udev/data"; ls -l /run/udev/data
for f in /run/udev/data/c13:*; do echo "-- $f"; cat "$f"; done

echo "== /sys/class/input/event0/"; ls -l /sys/class/input/event0/ /sys/class/input/event0/device/ 
cat /sys/class/input/event0/uevent

echo "== udevadm info /dev/input/event0"
udevadm info /dev/input/event0 2>&1
echo "exit $?"

echo "== udevadm info --export-db"
udevadm info --export-db 2>&1
echo "exit $?"

echo "== libinput list-devices"
LIBINPUT_LOG_PRIORITY=debug libinput list-devices --verbose 2>&1
echo "exit $?"
